---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
const game = `${base}game/index.html`;
const hasGame = fs.existsSync(new URL('../../public/game/index.html', import.meta.url));
---

<Base title="Play Pipe Maze 3D" bare>
  <div class="play">
    <div class="bar">
      <a class="back" href={base} title="Back to the site">← Pipe Maze 3D</a>
      <span class="actions">
        {hasGame && <button id="fs" type="button" title="Fullscreen">⛶</button>}
      </span>
    </div>
    {hasGame
      ? <iframe id="game" src={game} title="Pipe Maze 3D" allow="fullscreen; autoplay" allowfullscreen loading="eager"></iframe>
      : <div class="soon">
          <img src={`${base}images/logo.png`} alt="Pipe Maze 3D" width="360" />
          <p>The browser version is on its way. Until then, the trailer:</p>
          <a class="btn btn-blue" href="https://www.youtube.com/watch?v=ea3AvLVRcl8" target="_blank" rel="noopener">Watch the trailer</a>
        </div>}
  </div>
</Base>

<script>
  const frame = document.getElementById('game') as HTMLIFrameElement | null;
  document.getElementById('fs')?.addEventListener('click', () => {
    if (!frame) return;
    (frame.requestFullscreen ?? (frame as any).webkitRequestFullscreen)?.call(frame);
  });
</script>

<style>
  .play { height: 100dvh; display: flex; flex-direction: column; }
  .bar { flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.5rem 0.9rem; background: var(--panel); border-bottom: 1px solid var(--line); font-size: 0.9rem; }
  .back { color: var(--text); font-weight: 600; }
  .back:hover { text-decoration: none; color: var(--green); }
  .actions { display: flex; align-items: center; gap: 0.8rem; }
  #fs { font: inherit; background: transparent; border: 1px solid var(--green); color: var(--green); border-radius: 6px; padding: 0.25em 0.6em; cursor: pointer; }
  #fs:hover { background: var(--green); color: var(--bg); }
  #game { flex: 1 1 auto; width: 100%; border: 0; background: var(--bg); }
  .soon { flex: 1 1 auto; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; padding: 2rem; text-align: center; color: var(--muted); }
  .soon img { width: min(80vw, 360px); height: auto; }
</style>
